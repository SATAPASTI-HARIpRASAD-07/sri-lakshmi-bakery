# ====================================================================
# SRI LAKSHMI BAKERY - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env.local for local development or set in Vercel Dashboard.
# NEVER commit secret keys (SUPABASE_SERVICE_ROLE_KEY, RAZORPAY_KEY_SECRET) to Git!
# ====================================================================

# 1. SUPABASE INFRASTRUCTURE (FREE TIER)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# 2. RAZORPAY PAYMENT GATEWAY (NO MONTHLY SUBSCRIPTION)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# 3. EMAIL NOTIFICATIONS (RESEND FREE TIER)
RESEND_API_KEY=re_your_resend_api_key

# 4. GOOGLE MAPS PLATFORM (FREE CREDIT ALLOWANCE)
GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsKey

# 5. OFFICIAL BUSINESS WHATSAPP & PHONE
WHATSAPP_PHONE_NUMBER=919668569974
